{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jxstrr0.github.io/61/boards/_schema.json",
  "title": "61 board",
  "description": "One full game for 61 - A Trivia Game: two rounds of six categories by five clues, plus a final clue. tools/validate.js checks a board against this file and against the placement rules the schema cannot express (values per row, Daily Double placement, no repeated answers).",
  "type": "object",
  "required": ["id", "title", "pack", "difficulty", "tags", "rounds", "final"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Lowercase slug, equal to the file name without .json (general-01).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "pack": {
      "description": "Library grouping, shown as a filter chip (General, Sports, Prairie).",
      "type": "string",
      "minLength": 1
    },
    "difficulty": { "enum": ["easy", "normal", "hard"] },
    "tags": {
      "description": "Topic tags for the whole board, used by the Library and by per-category stats.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/round" }
    },
    "final": { "$ref": "#/$defs/final" }
  },
  "$defs": {
    "round": {
      "type": "object",
      "required": ["name", "multiplier", "categories"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "multiplier": {
          "description": "1 for round 1 (values 200-1000), 2 for round 2 (values 400-2000).",
          "enum": [1, 2]
        },
        "categories": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/category" }
        }
      }
    },
    "category": {
      "type": "object",
      "required": ["name", "clues"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "note": {
          "description": "Optional. Shown when the category is revealed, like the host's explanation. Required in practice whenever the name is wordplay.",
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "clues": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/clue" }
        }
      }
    },
    "clue": {
      "type": "object",
      "required": ["value", "text", "answer"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "Row value: 200, 400, 600, 800, 1000 in round 1; doubled in round 2. Clues are listed top row first.",
          "type": "integer"
        },
        "text": {
          "description": "The clue, written as a statement that points at the answer.",
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "description": "The canonical response, a short noun or name.",
          "type": "string",
          "minLength": 1
        },
        "accept": {
          "description": "Other responses counted as correct (nicknames, surname only, common misspellings).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "strict": {
          "description": "true when partial credit would be wrong (two-name answers, numbers, years): only exact or accept[] matches count, no surname-only rule.",
          "type": "boolean"
        },
        "dailyDouble": { "type": "boolean" }
      }
    },
    "final": {
      "type": "object",
      "required": ["category", "text", "answer"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 },
        "accept": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "strict": { "type": "boolean" }
      }
    }
  }
}
